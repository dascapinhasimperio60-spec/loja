# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# --- Endereços -------------------------------------------------------------
# Loja (domínio principal) e painel (subdomínio admin.)
NEXT_PUBLIC_SITE_URL=https://imperiodascapinhas.com.br
NEXT_PUBLIC_ADMIN_URL=https://admin.imperiodascapinhas.com.br
# Antes de ter domínio: deixe NEXT_PUBLIC_ADMIN_URL vazio e use https://SEU-PROJETO.vercel.app/admin

# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon" / "publishable" key. Nunca coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ImageKit (fotos) — Developer options > API keys ------------------------
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
# Chave privada: só no servidor. Nunca coloque NEXT_PUBLIC_ nela.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/seu_id

# --- Vercel Cron ------------------------------------------------------------
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" para /api/keepalive.
CRON_SECRET=
